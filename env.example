# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

# AI APIs (server-side only)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Admin
ADMIN_EMAIL=your-email@example.com

# Stripe — coins payments (Slice B2). Secret key + webhook secret are SECRET.
# Price IDs are not secret. Use sk_test_/whsec_ + test-mode price ids in dev;
# swap for the live-mode values on the deployed site. The webhook secret comes
# from `stripe listen` (local) or the dashboard endpoint (deployed) — see
# docs/stripe_setup_walkthrough.md.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_BOOSTER=price_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_BUILDER=price_...
STRIPE_PRICE_MASTER=price_...

# Upstash Redis (optional — falls back to in-memory rate limiting without these)
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token

# Observability (optional)
# SENTRY_DSN is read by server + edge runtimes.
# NEXT_PUBLIC_SENTRY_DSN is read by the browser client.
# Next only exposes NEXT_PUBLIC_* vars to the browser, so the two env
# vars are separate even though in practice they hold the same Sentry
# project DSN. Both are no-ops when unset; local dev works without them.
# SENTRY_DSN=https://xxxxx@o000000.ingest.sentry.io/0000000
# NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@o000000.ingest.sentry.io/0000000
